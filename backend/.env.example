# SQL Server connection string (Prisma format)

DATABASE_URL="sqlserver://38.247.137.216:1436;database=adetutu_wedding;user=sa;password=sqluser10$;encrypt=true;trustServerCertificate=true"
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the frontend URL)
CLIENT_ORIGINS=https://adetutu-wedding.vercel.app,http://localhost:5173

# Long random strings (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=CHANGE_ME
# Pepper used when hashing invitation session tokens
SESSION_TOKEN_SECRET=CHANGE_ME

# Lifetimes
ADMIN_SESSION_HOURS=8
INVITATION_SESSION_MINUTES=60

# Cookie SameSite: auto | none | lax | strict. Use "none" when frontend and API are on different sites.
COOKIE_SAMESITE=auto

# Set to 1 when behind a reverse proxy / load balancer (Render, Azure, Nginx...)
TRUST_PROXY=0

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_LongPassword
